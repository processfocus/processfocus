{
  "name": "@processfocus/plugin-posthog",
  "version": "0.1.0-next.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/processfocus/processfocus.git",
    "directory": "plugins/posthog"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/lib/register-client.d.ts",
      "bun": "./src/lib/register-client.tsx",
      "import": "./dist/lib/register-client.js",
      "default": "./dist/lib/register-client.js"
    },
    "./register-client": {
      "types": "./dist/lib/register-client.d.ts",
      "bun": "./src/lib/register-client.tsx",
      "import": "./dist/lib/register-client.js",
      "default": "./dist/lib/register-client.js"
    },
    "./activation-policy": {
      "types": "./dist/lib/activation-policy.d.ts",
      "bun": "./src/lib/activation-policy.ts",
      "import": "./dist/lib/activation-policy.js",
      "default": "./dist/lib/activation-policy.js"
    },
    "./browser": {
      "types": "./dist/lib/browser.d.ts",
      "bun": "./src/lib/browser.ts",
      "import": "./dist/lib/browser.js",
      "default": "./dist/lib/browser.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@pf/frontend-manifest": "workspace:*",
    "@pf/frontend-plugin-host": "workspace:*",
    "@pf/process": "workspace:*",
    "constructs": "^10.8.1",
    "posthog-js": "^1.418.16"
  },
  "peerDependencies": {
    "next": "^16.3.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
