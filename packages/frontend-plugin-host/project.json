{
  "name": "@pf/frontend-plugin-host",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/frontend-plugin-host/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": ["tsgo --build tsconfig.lib.json"]
      },
      "outputs": ["{projectRoot}/out-tsc/lib"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": ["tsgo -p tsconfig.spec.json --noEmit"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": ["bun test"]
      }
    }
  }
}
