{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "tsdown && tsc -p tsconfig.declarations.json && bun ../../scripts/finalize-sdk-distribution.ts"
      },
      "outputs": ["{projectRoot}/dist"],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/scripts/finalize-sdk-distribution.ts"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "tsgo -p tsconfig.lib.json --noEmit"
      },
      "outputs": []
    },
    "pack-check": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "bun scripts/verify-distribution.ts processfocus"
      },
      "outputs": [
        "{workspaceRoot}/dist/packages/processfocus",
        "{workspaceRoot}/dist/package-inspection/processfocus"
      ],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/scripts/verify-distribution.ts"
      ]
    },
    "external-fixture": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "pack-check",
        {
          "projects": ["@processfocus/runtime"],
          "target": "pack-check"
        },
        {
          "projects": [
            "@processfocus/plugin-aws-lambda",
            "@processfocus/plugin-posthog"
          ],
          "target": "pack-check"
        },
        "@pf/graphql-schema:graphql-codegen"
      ],
      "options": {
        "command": "bun scripts/verify-external-authoring.ts"
      },
      "outputs": []
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "dependsOn": ["pack-check"],
      "options": {
        "packageRoot": "dist/package-inspection/processfocus/package"
      }
    }
  }
}
