{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": ["tsgo --build tsconfig.lib.json"]
      },
      "inputs": ["default"],
      "outputs": ["{projectRoot}/out-tsc/lib"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": ["tsgo -p tsconfig.spec.json --noEmit"]
      }
    }
  }
}
