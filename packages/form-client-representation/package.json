{
  "name": "@pf/form-client-representation",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./plugin-registry": {
      "types": "./src/lib/plugin-registry.ts",
      "import": "./src/lib/plugin-registry.ts",
      "default": "./src/lib/plugin-registry.ts"
    },
    "./client-form-definition": {
      "types": "./src/lib/client-form-definition.ts",
      "import": "./src/lib/client-form-definition.ts",
      "default": "./src/lib/client-form-definition.ts"
    },
    "./types": {
      "types": "./src/lib/types.ts",
      "import": "./src/lib/types.ts",
      "default": "./src/lib/types.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@pf/form-rule": "workspace:*",
    "@pf/form-schema": "workspace:*",
    "@processfocus/runtime": "workspace:*",
    "effect": "^3.22.2"
  },
  "license": "SEE LICENSE IN LICENSE.md"
}
