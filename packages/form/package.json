{
  "name": "@pf/form",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./lookup-context": {
      "types": "./src/lib/lookup-context.tsx",
      "import": "./src/lib/lookup-context.tsx",
      "default": "./src/lib/lookup-context.tsx"
    },
    "./plugin-registry": {
      "types": "./src/lib/plugin-registry.ts",
      "import": "./src/lib/plugin-registry.ts",
      "default": "./src/lib/plugin-registry.ts"
    },
    "./package.json": "./package.json",
    "./effect-schema-form": {
      "types": "./src/lib/effect-schema-form.tsx",
      "import": "./src/lib/effect-schema-form.tsx",
      "default": "./src/lib/effect-schema-form.tsx"
    }
  },
  "dependencies": {
    "@pf/form-schema": "workspace:*",
