    "outDir": "./out-tsc/lib",
    "tsBuildInfoFile": "./out-tsc/lib/tsconfig.tsbuildinfo",
    "emitDeclarationOnly": true,
    "lib": ["esnext"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "references": [
    {
      "path": "../request-time/tsconfig.lib.json"
    },
    {
