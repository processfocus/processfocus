    },
    {
      "path": "../db-info/tsconfig.lib.json"
    },
    {
      "path": "../auth-session/tsconfig.lib.json"
    },
    {
      "path": "../auth-policy/tsconfig.lib.json"
    },
    {
      "path": "../auth-config/tsconfig.lib.json"
    }
  ],
  "exclude": ["test/**/*.test.ts"]
