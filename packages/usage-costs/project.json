{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": ["tsgo --build tsconfig.lib.json"]
      },
      "outputs": ["{projectRoot}/out-tsc/lib"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": ["tsgo -p tsconfig.spec.json --noEmit"]
      },
      "outputs": []
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bun test"
      },
      "inputs": ["default", "^production"],
      "outputs": ["{projectRoot}/test-output/coverage"],
      "dependsOn": ["^build"]
    },
    "lint-react-compiler": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.{ts,tsx}",
        "!{projectRoot}/**/*.{test,spec}.{ts,tsx}",
        "{workspaceRoot}/tools/eslint-react-compiler/**/*",
        {
          "externalDependencies": [
            "eslint",
            "eslint-plugin-react-hooks",
            "typescript-eslint"
          ]
        }
      ],
      "outputs": [],
      "options": {
        "command": "node tools/eslint-react-compiler/run.mjs --config tools/eslint-react-compiler/eslint.config.mjs --max-warnings 0 \"{projectRoot}/src\""
      },
      "metadata": {
        "description": "React Compiler diagnostics via eslint-plugin-react-hooks (usage-costs client source only)"
      }
    }
  }
}
