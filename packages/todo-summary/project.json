{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@pf/todo-summary",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": ["tsgo --build tsconfig.lib.json"]
      },
      "inputs": ["default"],
      "outputs": ["{projectRoot}/out-tsc/lib"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bun test"
      },
      "inputs": ["default", "^production"],
      "outputs": []
    }
  }
}
