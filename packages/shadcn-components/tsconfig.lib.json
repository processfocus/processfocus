{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "./out-tsc/lib",
    "tsBuildInfoFile": "./out-tsc/lib/tsconfig.tsbuildinfo",
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../form-schema/tsconfig.lib.json"
    }
  ]
}
