  "name": "@processfocus/runtime",
  "version": "0.1.0-next.2",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/processfocus/processfocus.git",
    "directory": "packages/runtime"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
