---
import "../styles/global.css"
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Page Not Found - Process Focus</title>
	</head>

	<body class="bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 min-h-screen">
		<main class="flex flex-col items-center justify-center min-h-screen px-4 text-center">
			<div class="max-w-4xl mx-auto">
				<h1 class="text-8xl font-bold text-white mb-4">404</h1>
				<p class="text-xl md:text-2xl text-slate-300 mb-8">Page not found</p>
				<a
					href="/"
					class="inline-flex items-center px-6 py-3 text-lg font-semibold text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition-colors duration-200"
				>
					Go Home
				</a>
			</div>
		</main>
	</body>
</html>
