{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": ["tsgo -p tsconfig.app.json"]
      },
      "outputs": ["{projectRoot}/out-tsc/app/**/*.d.ts"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": ["tsgo -p tsconfig.spec.json --noEmit"]
      },
      "inputs": ["default", "{projectRoot}/tsconfig.spec.json"],
      "dependsOn": ["build"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bun test"
      },
      "inputs": ["default", "^production"],
      "outputs": ["{projectRoot}/test-output/coverage"],
      "dependsOn": ["^build"]
    }
  }
}
